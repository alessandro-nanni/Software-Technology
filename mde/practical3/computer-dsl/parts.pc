// parts.pc

package my.shop.parts {

    motherboard AsusB650 {
        power 30
        type ATX
        chipset "B650"
        socket AM5
        ports USB, HDMI, Ethernet
    }

    processor Ryzen5 {
        power 65
        model "Ryzen 5 7600"
        socket AM5
        cores 6
    }

    graphics Rtx4060 {
        power 150
        model "RTX 4060"
        vram 8
    }

    memory Ddr5Kit16 {
        power 5
        type DDR5
        capacity 16
    }

    storage NvmeSsd1TB {
        power 8
        type SSD
        capacity 1000
    }

    drive DvdDrive {
        power 20
        type DVD_ROM
    }

    psu Corsair650 {
        capacity 650
        rating Gold
    }
}
