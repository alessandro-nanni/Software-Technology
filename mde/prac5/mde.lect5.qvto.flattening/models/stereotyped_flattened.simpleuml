  <ownedElements xsi:type="uml:PrimitiveType" name="String"/>
  <ownedElements xsi:type="uml:Association" name="carOwnership" source="//@ownedElements.0" target="//@ownedElements.2"/>
  <ownedElements xsi:type="uml:Association" name="residesAt" source="//@ownedElements.1" target="//@ownedElements.5"/>
