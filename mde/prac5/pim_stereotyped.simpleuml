  </ownedElements>
  <ownedElements xsi:type="uml:Class" name="Student">
    <stereotype>MVC</stereotype>
    <generalizations general="//@ownedElements.0"/>
    <generalizations general="//@ownedElements.1"/>
  </ownedElements>
  <ownedElements xsi:type="uml:Class" name="Employee">
    <generalizations general="//@ownedElements.0"/>
    <generalizations general="//@ownedElements.2"/>
  </ownedElements>
  <ownedElements xsi:type="uml:PrimitiveType" name="String"/>
