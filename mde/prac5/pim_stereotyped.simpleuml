  </ownedElements>
  <ownedElements xsi:type="uml:Association" name="carOwnership" source="//@ownedElements.6" target="//@ownedElements.8"/>
  <ownedElements xsi:type="uml:Association" name="supervisor" source="//@ownedElements.7" target="//@ownedElements.8"/>
  <ownedElements xsi:type="uml:Class" name="Course">
