  <bpmn:process id="payment-retrieval" name="Payment Retrieval" isExecutable="true" camunda:historyTimeToLive="10">
    <bpmn:startEvent id="StartEvent_1" name="Payment Retrieval Requested">
      <bpmn:outgoing>Flow_1jlx473</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_1jlx473" sourceRef="StartEvent_1" targetRef="Gateway_0ieo1o7" />
    <bpmn:serviceTask id="Activity_0vaqqrv" name="Charge Credit Card" camunda:type="external" camunda:topic="charge-card">
      <bpmn:incoming>Flow_1x498li</bpmn:incoming>
      <bpmn:incoming>Flow_1m1b9lg</bpmn:incoming>
      <bpmn:outgoing>Flow_1k0oc0g</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_14stdcs" sourceRef="Activity_1d41hg8" targetRef="Gateway_08xzbcu" />
    <bpmn:exclusiveGateway id="Gateway_0ieo1o7" name="Payment Amount?">
