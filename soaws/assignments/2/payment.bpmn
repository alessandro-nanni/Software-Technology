      <bpmn:outgoing>Flow_0f6pwmg</bpmn:outgoing>
      <bpmn:outgoing>Flow_1x498li</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0f6pwmg" name="&#62;=1000€" sourceRef="Gateway_0ieo1o7" targetRef="Activity_1d41hg8">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount&gt;=1000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1x498li" name="&#60; 1000€" sourceRef="Gateway_0ieo1o7" targetRef="Activity_0vaqqrv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${amount&lt;1000}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:exclusiveGateway id="Gateway_08xzbcu" name="Approved?">
      <bpmn:incoming>Flow_14stdcs</bpmn:incoming>
      <bpmn:outgoing>Flow_1m1b9lg</bpmn:outgoing>
      <bpmn:outgoing>Flow_1rh1pkt</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1m1b9lg" name="Yes" sourceRef="Gateway_08xzbcu" targetRef="Activity_0vaqqrv">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1y92zqh" name="Payment Retrieval Rejected">
      <bpmn:incoming>Flow_1rh1pkt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1rh1pkt" name="No" sourceRef="Gateway_08xzbcu" targetRef="Event_1y92zqh">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!approved}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0ey2mwa" name="Payment Received">
      <bpmn:incoming>Flow_1k0oc0g</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1k0oc0g" sourceRef="Activity_0vaqqrv" targetRef="Event_0ey2mwa" />
    <bpmn:businessRuleTask id="Activity_1d41hg8" name="Approve Payment" camunda:resultVariable="approved" camunda:decisionRef="approve-payment" camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>Flow_0f6pwmg</bpmn:incoming>
      <bpmn:outgoing>Flow_14stdcs</bpmn:outgoing>
    </bpmn:businessRuleTask>
  </bpmn:process>
